import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, onAuthStateChanged, signInAnonymously, signInWithCustomToken } from 'firebase/auth';
import { getFirestore, collection, doc, setDoc, onSnapshot, query, addDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';
import { 
  LayoutDashboard, 
  Plus, 
  List, 
  MessageCircle, 
  Send, 
  CheckCircle2, 
  Trash2, 
  Image as ImageIcon,
  ExternalLink,
  Copy,
  Zap,
  Wand2
} from 'lucide-react';

// Configuração Firebase (Injetada pelo ambiente)
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'achei-no-meli-saas';

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('list');
  const [offers, setOffers] = useState([]);
  const [toast, setToast] = useState({ show: false, message: '', type: 'success' });
  
  // Estado do formulário
  const [formData, setFormData] = useState({
    title: '',
    price: '',
    imageUrl: '',
    affiliateLink: ''
  });
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [isFetching, setIsFetching] = useState(false);

  // 1. Autenticação Segura
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Erro na autenticação:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // 2. Sincronização de Dados (Lendo as ofertas)
  useEffect(() => {
    if (!user) return;

    const offersRef = collection(db, 'artifacts', appId, 'users', user.uid, 'offers');
    
    // onSnapshot atualiza a lista em tempo real
    const unsubscribe = onSnapshot(offersRef, (snapshot) => {
      const loadedOffers = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      }));
      // Ordena localmente (mais recentes primeiro)
      loadedOffers.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      setOffers(loadedOffers);
    }, (error) => {
      console.error("Erro ao carregar ofertas:", error);
      showToast("Erro ao carregar dados.", "error");
    });

    return () => unsubscribe();
  }, [user]);

  // Exibir mensagens (Toast)
  const showToast = (message, type = 'success') => {
    setToast({ show: true, message, type });
    setTimeout(() => setToast({ show: false, message: '', type: 'success' }), 3000);
  };

  // 2.5 Buscar Dados Automaticamente (Web Scraper Invisível)
  const handleAutoFill = async () => {
    if (!formData.affiliateLink) {
      showToast("Cole o seu link de afiliado primeiro!", "error");
      return;
    }

    setIsFetching(true);
    try {
      // Usamos um proxy (AllOrigins) para contornar o bloqueio de segurança do navegador (CORS) e conseguir ler a página
      const response = await fetch(`https://api.allorigins.win/get?url=${encodeURIComponent(formData.affiliateLink)}`);
      const data = await response.json();
      const html = data.contents;

      const parser = new DOMParser();
      const doc = parser.parseFromString(html, "text/html");

      // Tenta encontrar o Título nas tags ocultas
      let title = doc.querySelector('meta[property="og:title"]')?.content || '';
      if (title.includes(' - Mercado')) title = title.split(' - Mercado')[0];
      if (title.includes(' | ')) title = title.split(' | ')[0];

      // Tenta encontrar a Imagem em alta resolução
      const imageUrl = doc.querySelector('meta[property="og:image"]')?.content || '';

      // Tenta encontrar o Preço
      let price = doc.querySelector('meta[property="og:price:amount"]')?.content;
      if (!price) {
        // Fallback: se não achar a tag principal, procura pelo texto do preço
        const fraction = doc.querySelector('.andes-money-amount__fraction')?.innerText;
        if (fraction) price = fraction.replace('.', ''); // Remove separador de milhar para formatar depois
      }

      // Formata o preço para o padrão Brasileiro (R$ 1.999,00)
      if (price) {
        price = parseFloat(price).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      }

      setFormData(prev => ({
        ...prev,
        title: title || prev.title,
        price: price || prev.price,
        imageUrl: imageUrl || prev.imageUrl
      }));

      if (title || price) {
        showToast("Dados extraídos com sucesso! ✨");
      } else {
        showToast("Não consegui ler tudo, mas você pode completar manualmente.", "error");
      }

    } catch (error) {
      console.error("Erro na extração:", error);
      showToast("Falha ao analisar o link.", "error");
    } finally {
      setIsFetching(false);
    }
  };

  // 3. Adicionar Nova Oferta
  const handleAddOffer = async (e) => {
    e.preventDefault();
    if (!user) return;
    
    if (!formData.title || !formData.price || !formData.affiliateLink) {
      showToast("Preencha os campos obrigatórios!", "error");
      return;
    }

    setIsSubmitting(true);
    try {
      const newOffer = {
        title: formData.title,
        price: formData.price,
        imageUrl: formData.imageUrl,
        affiliateLink: formData.affiliateLink,
        status: 'Pendente',
        createdAt: Date.now()
      };
      
      await addDoc(collection(db, 'artifacts', appId, 'users', user.uid, 'offers'), newOffer);
      showToast("Oferta adicionada com sucesso!");
      setFormData({ title: '', price: '', imageUrl: '', affiliateLink: '' });
      setActiveTab('list');
    } catch (error) {
      console.error(error);
      showToast("Erro ao guardar oferta.", "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  // 4. Marcar como Enviado / Excluir
  const toggleStatus = async (id, currentStatus) => {
    if (!user) return;
    const newStatus = currentStatus === 'Pendente' ? 'Enviado' : 'Pendente';
    try {
      await updateDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'offers', id), {
        status: newStatus
      });
      showToast(`Status alterado para ${newStatus}`);
    } catch (error) {
      console.error(error);
      showToast("Erro ao alterar status.", "error");
    }
  };

  const deleteOffer = async (id) => {
    if (!user) return;
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'offers', id));
      showToast("Oferta excluída.");
    } catch (error) {
      console.error(error);
      showToast("Erro ao excluir.", "error");
    }
  };

  // 5. Copiar para o WhatsApp (Formatação Inteligente)
  const copyToWhatsApp = (offer) => {
    const text = `🚨 *NOVA OFERTA IMPERDÍVEL!* 🚨\n\n📦 *${offer.title}*\n\n💰 *Por apenas:* R$ ${offer.price}\n🚚 Aproveite antes que esgote!\n\n👉 *Compre aqui com segurança:*\n🔗 ${offer.affiliateLink}`;
    
    // Método seguro para iframe
    const textArea = document.createElement("textarea");
    textArea.value = text;
    document.body.appendChild(textArea);
    textArea.select();
    try {
      document.execCommand('copy');
      showToast("Copiado para o WhatsApp! 🟢");
      
      if(offer.status === 'Pendente') {
        toggleStatus(offer.id, 'Pendente');
      }
    } catch (err) {
      console.error('Falha ao copiar', err);
      showToast("Erro ao copiar texto.", "error");
    }
    document.body.removeChild(textArea);
  };

  if (!user) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center text-white">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-yellow-400"></div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#0A0F1C] text-slate-200 font-sans flex">
      {/* Toast Notification */}
      {toast.show && (
        <div className={`fixed top-4 right-4 z-50 px-6 py-3 rounded-xl font-bold shadow-2xl transition-all flex items-center gap-2 ${
          toast.type === 'success' ? 'bg-yellow-400 text-slate-900' : 'bg-red-500 text-white'
        }`}>
          {toast.type === 'success' ? <CheckCircle2 size={20} /> : <Trash2 size={20} />}
          {toast.message}
        </div>
      )}

      {/* Sidebar */}
      <nav className="w-64 bg-[#111827] border-r border-slate-800 p-6 flex flex-col gap-8 hidden md:flex">
        <div className="flex items-center gap-3">
          <div className="w-12 h-12 rounded-full overflow-hidden border-2 border-yellow-400 shadow-lg shadow-yellow-500/20 bg-yellow-400 flex-shrink-0">
            {/* O caminho ./logo.png assumirá que a imagem que enviou foi renomeada e colocada na raiz do projeto final */}
            <img 
              src="./logo.png" 
              alt="Logo Achei no Meli" 
              className="w-full h-full object-cover"
              onError={(e) => {
                e.target.style.display = 'none';
                e.target.parentElement.innerHTML = '<div class="w-full h-full flex items-center justify-center text-slate-900 font-bold">AM</div>';
              }}
            />
          </div>
          <div>
            <h1 className="text-xl font-black tracking-tight text-white leading-tight">Achei no Meli</h1>
            <span className="text-[10px] text-yellow-400 uppercase font-bold tracking-widest">Painel PWA</span>
          </div>
        </div>

        <div className="flex flex-col gap-2">
          <button 
            onClick={() => setActiveTab('list')}
            className={`flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium ${
              activeTab === 'list' 
                ? 'bg-slate-800/80 text-yellow-400 border border-slate-700 shadow-sm' 
                : 'hover:bg-slate-800/50 text-slate-400 hover:text-slate-200'
            }`}
          >
            <List size={20} /> Gestão de Ofertas
          </button>
          <button 
            onClick={() => setActiveTab('add')}
            className={`flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-medium ${
              activeTab === 'add' 
                ? 'bg-yellow-400/10 text-yellow-400 border border-yellow-400/20' 
                : 'hover:bg-slate-800/50 text-slate-400 hover:text-slate-200'
            }`}
          >
            <Plus size={20} /> Nova Oferta
          </button>
        </div>

        <div className="mt-auto bg-slate-800/30 p-4 rounded-2xl border border-slate-700/50">
          <p className="text-xs text-slate-500 mb-2">Canal Principal</p>
          <div className="flex items-center gap-2 text-sm text-yellow-400 font-bold bg-[#0A0F1C] p-2 rounded-lg border border-slate-700">
            <Send size={14} className="text-yellow-400" /> @acheinomeli01
          </div>
        </div>
      </nav>

      {/* Main Content */}
      <main className="flex-1 overflow-y-auto bg-[#0A0F1C]">
        
        {/* Mobile Header */}
        <div className="md:hidden bg-[#111827] p-4 border-b border-slate-800 flex justify-between items-center sticky top-0 z-40">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-full overflow-hidden border border-yellow-400 bg-yellow-400">
              <img 
                src="./logo.png" 
                alt="Logo" 
                className="w-full h-full object-cover"
                onError={(e) => {
                  e.target.style.display = 'none';
                }}
              />
            </div>
            <h1 className="font-bold text-white tracking-tight">Achei no Meli</h1>
          </div>
          <div className="flex gap-2">
            <button onClick={() => setActiveTab('list')} className={`p-2 rounded-lg transition-colors ${activeTab === 'list' ? 'bg-slate-800 text-yellow-400' : 'text-slate-400'}`}><List size={20} /></button>
            <button onClick={() => setActiveTab('add')} className={`p-2 rounded-lg transition-colors ${activeTab === 'add' ? 'bg-yellow-400/10 text-yellow-400' : 'text-slate-400'}`}><Plus size={20} /></button>
          </div>
        </div>

        <div className="p-6 md:p-10 max-w-6xl mx-auto">
          
          {/* TAB: LISTAR OFERTAS */}
          {activeTab === 'list' && (
            <div className="animate-in fade-in slide-in-from-bottom-4 duration-300">
              <div className="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                <div>
                  <h2 className="text-3xl font-black text-white mb-1">Central de Ofertas</h2>
                  <p className="text-slate-400">Gira os seus produtos e copie rapidamente para as redes sociais.</p>
                </div>
                <button 
                  onClick={() => setActiveTab('add')}
                  className="bg-yellow-400 hover:bg-yellow-500 text-[#111827] px-6 py-3 rounded-xl font-bold transition-all shadow-lg shadow-yellow-500/10 flex items-center gap-2"
                >
                  <Plus size={20} /> Adicionar Produto
                </button>
              </div>

              {offers.length === 0 ? (
                <div className="bg-[#111827] border border-slate-800 rounded-3xl p-12 text-center shadow-sm">
                  <div className="bg-slate-800 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <List size={32} className="text-slate-500" />
                  </div>
                  <h3 className="text-xl font-bold text-white mb-2">Nenhuma oferta cadastrada</h3>
                  <p className="text-slate-400 mb-6 max-w-md mx-auto">Comece a adicionar os seus links de afiliado para montar o seu arsenal de vendas.</p>
                  <button onClick={() => setActiveTab('add')} className="text-yellow-400 font-bold hover:text-yellow-300">
                    + Adicionar a primeira oferta
                  </button>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {offers.map(offer => (
                    <div key={offer.id} className="bg-[#111827] border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-colors shadow-sm group">
                      {/* Imagem (com fallback) */}
                      <div className="h-48 bg-slate-800 relative overflow-hidden flex items-center justify-center">
                        {offer.imageUrl ? (
                          <img src={offer.imageUrl} alt={offer.title} className="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
                        ) : (
                          <ImageIcon size={40} className="text-slate-600" />
                        )}
                        <div className="absolute top-3 left-3">
                          <span className={`text-[10px] uppercase font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-lg backdrop-blur-md ${
                            offer.status === 'Enviado' 
                              ? 'bg-yellow-400 text-slate-900 border border-yellow-300' 
                              : 'bg-slate-800/80 text-slate-300 border border-slate-600'
                          }`}>
                            {offer.status === 'Enviado' ? <CheckCircle2 size={12} className="text-slate-900" /> : <span className="w-1.5 h-1.5 rounded-full bg-slate-400"></span>}
                            {offer.status}
                          </span>
                        </div>
                      </div>
                      
                      {/* Conteúdo */}
                      <div className="p-5">
                        <h3 className="font-bold text-white text-lg line-clamp-2 mb-2 leading-tight">{offer.title}</h3>
                        <p className="text-yellow-400 font-black text-2xl mb-5">R$ {offer.price}</p>
                        
                        {/* Ações */}
                        <div className="space-y-3">
                          <button 
                            onClick={() => copyToWhatsApp(offer)}
                            className="w-full bg-[#25D366] hover:bg-[#20bd5a] text-white py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-lg shadow-[#25D366]/20"
                          >
                            <MessageCircle size={18} /> Copiar p/ WhatsApp
                          </button>
                          
                          <div className="grid grid-cols-2 gap-2">
                            <button 
                              onClick={() => toggleStatus(offer.id, offer.status)}
                              className="bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm py-2.5 rounded-xl font-medium transition-all"
                            >
                              {offer.status === 'Pendente' ? 'Marcar Enviado' : 'Voltar Pendente'}
                            </button>
                            <button 
                              onClick={() => deleteOffer(offer.id)}
                              className="bg-red-500/10 hover:bg-red-500/20 text-red-400 text-sm py-2.5 rounded-xl font-medium transition-all flex justify-center items-center"
                            >
                              <Trash2 size={16} /> Excluir
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* TAB: ADICIONAR OFERTA */}
          {activeTab === 'add' && (
            <div className="max-w-2xl mx-auto animate-in fade-in slide-in-from-right-4 duration-300">
              <div className="mb-8">
                <h2 className="text-3xl font-black text-white mb-2">Cadastrar Oferta</h2>
                <p className="text-slate-400">Adicione os detalhes do produto. Ele ficará disponível no seu painel para publicação.</p>
              </div>

              <form onSubmit={handleAddOffer} className="bg-[#111827] border border-slate-800 p-6 md:p-8 rounded-3xl space-y-6 shadow-sm">
                
                {/* CAMPO MÁGICO (LINK) */}
                <div className="space-y-2 p-6 bg-blue-900/10 border border-blue-500/30 rounded-2xl relative overflow-hidden shadow-inner">
                  <div className="absolute top-0 right-0 w-40 h-40 bg-blue-500/10 blur-3xl rounded-full"></div>
                  <label className="text-sm font-bold text-blue-400 uppercase tracking-wider flex items-center gap-2 relative z-10">
                    <Wand2 size={16} /> 1. Cole seu Link de Afiliado Aqui
                  </label>
                  <div className="flex flex-col md:flex-row gap-3 relative z-10 mt-2">
                    <input 
                      type="url" 
                      placeholder="https://mercadolivre.com/sec/..."
                      className="flex-1 bg-[#0A0F1C] border border-slate-700 rounded-xl px-4 py-4 focus:outline-none focus:ring-2 focus:ring-blue-500 text-white transition-all"
                      value={formData.affiliateLink}
                      onChange={(e) => setFormData({...formData, affiliateLink: e.target.value})}
                      required
                    />
                    <button 
                      type="button"
                      onClick={handleAutoFill}
                      disabled={isFetching || !formData.affiliateLink}
                      className="bg-blue-600 hover:bg-blue-500 disabled:bg-slate-800 disabled:text-slate-500 text-white px-6 py-4 rounded-xl font-bold transition-all flex items-center justify-center gap-2 whitespace-nowrap shadow-lg shadow-blue-900/20"
                    >
                      {isFetching ? <span className="animate-spin rounded-full h-5 w-5 border-t-2 border-b-2 border-white"></span> : '✨ Auto-Preencher'}
                    </button>
                  </div>
                  <p className="text-xs text-slate-400 mt-3 relative z-10">Cole o link e clique no botão para extrair o título, preço e foto automaticamente.</p>
                </div>

                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-400 uppercase tracking-wider">2. Título do Produto *</label>
                  <input 
                    type="text" 
                    placeholder="Ex: Smartphone Samsung Galaxy S23"
                    className="w-full bg-[#0A0F1C] border border-slate-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white transition-all"
                    value={formData.title}
                    onChange={(e) => setFormData({...formData, title: e.target.value})}
                    required
                  />
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div className="space-y-2">
                    <label className="text-sm font-bold text-slate-400 uppercase tracking-wider">Preço (R$) *</label>
                    <input 
                      type="text" 
                      placeholder="Ex: 2.999,00"
                      className="w-full bg-[#0A0F1C] border border-slate-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white transition-all font-bold"
                      value={formData.price}
                      onChange={(e) => setFormData({...formData, price: e.target.value})}
                      required
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                      Link da Imagem <span className="text-xs text-slate-500 normal-case">(Opcional)</span>
                    </label>
                    <input 
                      type="url" 
                      placeholder="https://..."
                      className="w-full bg-[#0A0F1C] border border-slate-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white transition-all"
                      value={formData.imageUrl}
                      onChange={(e) => setFormData({...formData, imageUrl: e.target.value})}
                    />
                  </div>
                </div>

                <div className="pt-6 mt-8 border-t border-slate-800">
                  <button 
                    type="submit" 
                    disabled={isSubmitting}
                    className="w-full bg-yellow-400 hover:bg-yellow-500 text-slate-900 py-4 rounded-xl font-black text-lg shadow-xl shadow-yellow-500/10 transition-all disabled:opacity-50 flex items-center justify-center gap-2 uppercase tracking-wide"
                  >
                    {isSubmitting ? (
                      <span className="animate-spin rounded-full h-5 w-5 border-t-2 border-b-2 border-slate-900"></span>
                    ) : (
                      <>Guardar Oferta <CheckCircle2 size={22} /></>
                    )}
                  </button>
                </div>
              </form>
            </div>
          )}

        </div>
      </main>
    </div>
  );
}
